# Copy this file to .env for local development.
APP_NAME=Smart Teaching Assistant
APP_VERSION=0.1.0
APP_TAGLINE=Face-recognition attendance, student records and classroom insights in one place.

# Demo mode needs no heavy dependencies. Set false after installing face_recognition.
DEMO_MODE=true

# Lower is stricter. Typical face_recognition distance is 0.45 - 0.60.
ATTENDANCE_THRESHOLD=0.60

DATA_DIR=data
DATABASE_PATH=data/teaching_assistant.db
